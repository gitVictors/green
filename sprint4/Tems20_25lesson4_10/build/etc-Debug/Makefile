	g++ -pipe -g -std=gnu++2a -Wall -Wextra -fPIC -dM -E -o moc_predefs.h /media/stepan/E6C635BBC6358CB5/Qt/6.5.0/gcc_64/mkspecs/features/data/dummy.cpp

