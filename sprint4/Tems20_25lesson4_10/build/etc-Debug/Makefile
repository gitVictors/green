####### Compile

main.o: ../../main.cpp ../../robot.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o main.o ../../main.cpp

####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/opt/submission/bin || mkdir -p $(INSTALL_ROOT)/opt/submission/bin
	$(QINSTALL_PROGRAM) $(QMAKE_TARGET) $(INSTALL_ROOT)/opt/submission/bin/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/opt/submission/bin/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/submission/bin/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

